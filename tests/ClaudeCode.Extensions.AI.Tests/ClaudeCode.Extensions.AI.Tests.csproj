<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="ClaudeCode" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClaudeCode.Extensions.AI\ClaudeCode.Extensions.AI.csproj" />
    <!-- Build-order only: guarantees the sample is built before tests check its output. -->
    <ProjectReference Include="..\..\samples\ConsoleChat\ConsoleChat.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- Real reference: the PromptWorker processor is unit tested here. -->
    <ProjectReference Include="..\..\samples\PromptWorker\PromptWorker.csproj" />
    <!-- Integration tested through WebApplicationFactory<Program>. -->
    <ProjectReference Include="..\..\samples\StreamingApi\StreamingApi.csproj" />
  </ItemGroup>

</Project>
