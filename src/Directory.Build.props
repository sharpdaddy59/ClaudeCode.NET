<Project>

  <!-- Shared by every package under src/. The packages version in lockstep: one tag
       publishes them all (release.yml reads the version from this file). -->
  <PropertyGroup>
    <Version>1.0.2</Version>

    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Authors>Greg Haley</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/sharpdaddy59/ClaudeCode.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sharpdaddy59/ClaudeCode.NET</RepositoryUrl>
    <PackageReleaseNotes>https://github.com/sharpdaddy59/ClaudeCode.NET/releases</PackageReleaseNotes>

    <!-- SourceLink: consumers can step into this package's source while debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
