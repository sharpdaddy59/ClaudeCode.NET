<Project Sdk="Microsoft.NET.Sdk">

  <!-- Version, target frameworks and shared package metadata: ../Directory.Build.props -->
  <PropertyGroup>
    <PackageId>ClaudeCode.Net</PackageId>
    <Description>Drive Claude Code CLI sessions from .NET: typed stream-json events, session resume, and safe argument handling. Works with Max plan authentication (claude login) - no API key required.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>claude;claude-code;agent;ai;anthropic;cli</PackageTags>
    <!-- Self-describing record properties don't each need XML docs at 0.x -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI.Abstractions is already transitive via Logging.Abstractions; referencing it
         directly adds no packages to the consumer's graph -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="ClaudeCode.Tests" />
  </ItemGroup>

</Project>
